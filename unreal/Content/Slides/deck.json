      "accent": "#7b303e",
      "blocks": [
        {
          "kind": "h2",
          "text": "THE PROBLEM / 02"
        },
        {
          "kind": "li",
          "text": "Trust: who made and reviewed this change?"
        },
        {
          "kind": "li",
          "text": "Provenance: which prompts and transcripts produced it?"
        },
        {
          "kind": "li",
          "text": "Review, testing, licensing and binary-file hints."
        },
        {
          "kind": "p",
          "text": "Commit trailers and notes leave us with size limits, fixed fields and limited control over metadata properties."
        }
      ],
