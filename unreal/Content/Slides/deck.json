      "title": "Small commands. Rich context.",
      "accent": "#563d72",
      "blocks": [
        {
          "kind": "h2",
          "text": "THE CLI / 04"
        },
        {
          "kind": "pre",
          "text": "git meta set commit:314e7f0fa7 agent:model \"claude-opus-4-6[1m]\"\ngit meta list:push branch:sc-feature-1 review:comments \"love it\"\ngit meta set:add path:src/metrics owners schacon\n"
        },
        {
          "kind": "p",
          "text": "Keys can be deeply namespaced. Read a namespace to retrieve its subkeys."
        }
      ],
      "models": [],
      "notes": "These commands come from the README examples. Refer to git-meta/spec for current CLI semantics.",
