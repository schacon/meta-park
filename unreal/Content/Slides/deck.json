      "blocks": [
        {
          "kind": "h2",
          "text": "COLLABORATION / 06"
        },
        {
          "kind": "p",
          "text": "Separate keys become separate tree entries."
        },
        {
          "kind": "li",
          "text": "Independent edits merge naturally."
        },
        {
          "kind": "li",
          "text": "The README proposes local preference for conflicting values."
        },
        {
          "kind": "li",
          "text": "Append-only list entries can combine across collaborators."
        },
        {
          "kind": "li",
          "text": "Explicit tombstones express deletion; absence does not."
        }
      ],
