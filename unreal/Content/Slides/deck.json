      "accent": "#294e7e",
      "blocks": [
        {
          "kind": "h2",
          "text": "THE DATA MODEL / 03"
        },
        {
          "kind": "p",
          "text": "Target + namespaced key + value."
        },
        {
          "kind": "li",
          "text": "Targets: commit, change ID, path, branch, project."
        },
        {
          "kind": "li",
          "text": "Strings for individual values."
        },
        {
          "kind": "li",
          "text": "Lists for appended entries; sets for unique members."
        }
      ],
