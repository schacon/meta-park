      "title": "Local speed. Git transport.",
      "accent": "#7b303e",
      "blocks": [
        {
          "kind": "h2",
          "text": "STORAGE & EXCHANGE / 05"
        },
        {
          "kind": "p",
          "text": "Work with tuples in a local SQLite database."
        },
        {
          "kind": "p",
          "text": "Serialize shared values into a Git tree, then commit to refs/meta/local/main."
        },
        {
          "kind": "p",
          "text": "Fetch metadata into refs/meta/remotes/main and materialize it into the local store."
        }
      ],
