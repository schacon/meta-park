alse);\\n if(bIsland) { Camera->GetCameraComponent()->SetProjectionMode(ECameraProjectionMode::Orthographic); Camera->GetCameraComponent()->SetOrthoWidth(25000); }\\n FVector Center=FVector::ZeroVector; for(const auto& V:Views) Center+=V.Position; Center/=Views.Num();\\n FVector Eye=bIsland?FVector(3000,-28000,23000):Center+FVector(9000,-6000,10000);\\n if(bIsland) { Center=FVector(2500,250,0); Eye+=Center; }\\n Camera->SetActorLocationAndRotation(Eye,(Center-Eye).Rotation());\\n}\\nvoid ASlideGameMode::Tick(float Delta) {\\n Super::Tick(Delta); if(!Camera || Views.IsEmpty()) return; Elapsed+=Delta;\\n if(bTourStarted&&!bTimerPaused) TimerElapsed+=Delta;\\n if(MascotActor) MascotActor->SetActorRotation(FRotator(0,Elapsed*32,0));\\n for(auto& Panel:Panels) if(Panel.Root.IsValid()) {\\n  const float D=FVector::Distance(Camera->GetActorLocation(),Panel.RaisedPosition);\\n  const float Target=bOverview?0.f:1-FMath::SmoothStep(2500.f,3900.f,D);\\n  Panel.Reveal=FMath::FInterpTo(Panel.Reveal,Target,Delta,4.f);\\n{\\n  \\\"version\\\": 1,\\n  \\\"scene\\\": \\\"isla-nublar\\\",\\n  \\\"seed\\\": 1993,\\n  \\\"transition\\\": 5,\\n  \\\"habitats\\\": [\\n    {\\n      \\\"id\\\": \\\"brachiosaurus\\\",\\n      \\\"label\\\": \\\"Brachiosaurus lagoon\\\",\\n      \\\"species\\\": \\\"brachiosaurus\\\",\\n      \\\"position\\\": [\\n        5500,\\n        2200,\\n        200\\n      ],\\n      \\\"color\\\": \\\"#459cac\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"tyrannosaurus\\\",\\n      \\\"label\\\": \\\"T. rex paddock\\\",\\n      \\\"species\\\": \\\"tyrannosaurus\\\",\\n      \\\"position\\\": [\\n        -5500,\\n        1800,\\n        200\\n      ],\\n      \\\"color\\\": \\\"#e97936\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"triceratops\\\",\\n      \\\"label\\\": \\\"Triceratops meadow\\\",\\n      \\\"species\\\": \\\"triceratops\\\",\\n      \\\"position\\\": [\\n        5400,\\n        -3800,\\n        200\\n      ],\\n      \\\"color\\\": \\\"#d4be70\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"velociraptor\\\",\\n      \\\"label\\\": \\\"Raptor enclosure\\\",\\n      \\\"species\\\": \\\"velociraptor\\\",\\n      \\\"position\\\": [\\n        -5500,\\n        -3700,\\n        200\\n      ],\\n      \\\"color\\\": \\\"#82a268\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"dilophosaurus\\\",\\n      \\\"label\\\": \\\"Dilophosaurus forest\\\",\\n      \\\"species\\\": \\\"dilophosaurus\\\",\\n      \\\"position\\\": [\\n        5500,\\n        7000,\\n        220\\n      ],\\n      \\\"color\\\": \\\"#b6ad5c\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"gallimimus\\\",\\n      \\\"label\\\": \\\"Gallimimus valley\\\",\\n      \\\"species\\\": \\\"gallimimus\\\",\\n      \\\"position\\\": [\\n        -5300,\\n        7000,\\n        220\\n      ],\\n      \\\"color\\\": \\\"#e5a450\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"stegosaurus\\\",\\n      \\\"label\\\": \\\"Stegosaurus range\\\",\\n      \\\"species\\\": \\\"stegosaurus\\\",\\n      \\\"position\\\": [\\n        4300,\\n        -8400,\\n        200\\n      ],\\n      \\\"color\\\": \\\"#7e9b5e\\\"\\n    },\\n    {\\n      \\\"id\\\": \\\"parasaurolophus\\\",\\n      \\\"label\\\": \\\"Parasaurolophus wetlands\\\",\\n      \\\"species\\\": \\\"parasaurolophus\\\",\\n      \\\"position\\\": [\\n        -4000,\\n        -8400,\\n        200\\n      ],\\n      \\\"color\\\": \\\"#729fa8\\\"\\n    }\\n  ],\\n  \\\"slides\\\": {},\\n  \\\"durationMinutes\\\": 20\\n}\\n{\\\"name\\\":\\\"unreal-mdx-slides\\\",\\\"version\\\":\\\"0.1.0\\\",\\\"private\\\":true,\\\"type\\\":\\\"module\\\",\\\"scripts\\\":{\\\"build\\\":\\\"node scripts/build.mjs\\\",\\\"test\\\":\\\"node --test\\\",\\\"unreal:build\\\":\\\"node scripts/unreal.mjs build\\\",\\\"unreal:prepare\\\":\\\"node scripts/unreal.mjs prepare\\\",\\\"unreal:play\\\":\\\"node scripts/unreal.mjs play\\\",\\\"unreal:package\\\":\\\"node scripts/unreal.mjs package\\\"},\\\"dependencies\\\":{\\\"@mdx-js/esbuild\\\":\\\"