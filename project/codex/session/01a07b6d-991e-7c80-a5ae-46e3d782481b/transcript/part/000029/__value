(station.card.view,JSON.parse(await readFile(layout)).cards[0].view);\\n assert.equal(deck.slides[7].card.hidden,true);\\n});\\ntest('native scene components work alone or with Markdown and notes',async t=>{\\n const dir=await fixture(t);\\n await writeFile(join(dir,'01/02-model.mdx'),'<Animate kind=\\\"bob\\\"><Model /></Animate>\\\\n\\\\n<Notes>Watch it move.</Notes>');\\n await writeFile(join(dir,'01/03-mixed.mdx'),'# Models\\\\n\\\\nA rotating cube.\\\\n\\\\n<Animate><Model /></Animate>');\\n const steps=(await compileStations(dir,layout)).slides[0].steps;\\n assert.equal(steps[1].component.type,'Scene');assert.equal(steps[1].models[0].animation.kind,'bob');\\n assert.equal(steps[1].notes,'Watch it move.');\\n assert.equal(steps[2].kind,'slide');assert.equal(steps[2].models.length,1);\\n});\\ntest('invalid native components and empty stations fail with an actionable source path',async t=>{\\n const dir=await fixture(t);const file=join(dir,'01/02-bad.mdx');\\n await writeFile(file,'<Computer><prompt>hello</prompt></Computer>');\\n await assert.rejects(compileStations(dir,layout),/02-bad.mdx: Computer needs/);\\n await writeFile(file,'# Mixed\\\\n\\\\n<Computer><prompt>hello</prompt><output>OK</output></Computer>');\\n await assert.rejects(compileStations(dir,layout),/02-bad.mdx: Unsupported MDX element: computer/);\\n await writeFile(file,'<Unknown />');\\n await assert.rejects(compileStations(dir,layout),/02-bad.mdx:.*Unknown/);\\n await rm(file);await rm(join(dir,'01/01-intro.mdx'));\\n await assert.rejects(compileStations(dir,layout),/01: station needs/);\\n});\\nEOF\\nnpm test > /tmp/station-js-tests.log 2>&1\\nnode scripts/unreal.mjs smoke -TerminalTest -SlideTestWidth=1440 -SlideTestHeight=900 > /tmp/station-terminal-test.log 2>&1\",\"yield_time_ms\":1000,\"max_output_tokens\":1500}));\n","name":"exec","session_id":"01a07b6d-991e-7c80-a5ae-46e3d782481b","source_line":6400,"timestamp":"2026-09-08T19:00:40.865Z","type":"custom_tool_call"}
