uteCard,view:routeCard.view??{\\n      anchor:[routeCard.position[0],routeCard.position[1]-2200,0],\\n      eye:[routeCard.position[0]+2400,routeCard.position[1]-5000,routeCard.position[2]+1500],\\n      signYaw:-45,signHeight:1100,\\n      path:[[routeCard.position[0]*1.5,-26000,30000],[routeCard.position[0]+6000,routeCard.position[1]-7000,7000]]\\n    }}:null;\\n    const angle = i * 0.48;\\n    const position = vector(override.position,habitat ? [habitat.position[0],habitat.position[1],habitat.position[2]+3200] : [Math.round(4200*Math.sin(angle)),Math.round(4200*(1-Math.cos(angle))),i*380],`${id}.position`);\\n    return {id,title,accent,blocks,models,notes,position,card:nativeCard,habitat:habitat?.id??\\\"\\\",yaw: (()=>{const y=override.yaw??(island ? -90 : i*27.5); if(!Number.isFinite(y))fail('yaw must be finite'); return y;})(), cameraDistance:positive(override.cameraDistance,island ? 2050 : 1550,'cameraDistance'), transition:positive(override.transition,layout.transition??(island ? 5 : 2.2),'transition')};\\n  });\\n  for (const id of Object.keys(layout.slides??{})) if (!ids.has(id)) fail(`Layout references unknown slide: ${id}`);\\n  return {version:1,title:root.props.title??'Presentation',durationSeconds:positive(layout.durationMinutes,20,'durationMinutes')*60,scene:island?.scene??'gallery',seed:island?.seed??0,habitats:island?.habitats??[],slides:result};\\n}\\nexport async function compileDeck(input, layoutFile) {\\n  // Bundle beside the project so React and local MDX imports resolve consistently.\\n  const temp = await mkdtemp(resolve('.slide-build-'));\\n  try {\\n    const outfile = join(temp,'deck.mjs');\\n    await build({entryPoints:[resolve(input)],outfile,bundle:true,platform:'node',format:'esm',plugins:[mdx()],packages:'external',logLevel:'silent'});\\n    const mod = await import(pathToFileURL(outfile).href);\\n    const layout = layoutFile ? JSON.parse(await readFile(layoutFile,'utf8')) : {};\\n    return makeManifest(mod.default({}),layout);\\n  } finally { await rm(temp,{recursive:true,force:true}); }\\n}\\nimport {createElement} from 'react';\\nexport const Deck = props => createElement('deck', props);\\nexport const Slide = props => createElement('slide', props);\\nexport const Model = props => createElement('model', props);\\nexport const Animate = props => createElement('animate', props);\\nexport const Notes = props => createElement('notes', props);\\nimport {test} from 'node:test';\\nimport assert from 'node:assert/strict';\\nimport React from 'react';\\nimport {compileDeck,makeManifest} from '../src/compiler.mjs';\\nconst h=React.createElement;\\nconst slide=(id='one',children=[])=>h('slide',{id,title:id},...children);\\nconst deck=(...slides)=>h('deck',{title:'Test'},...slides);\\ntest('example compiles seven visible slides and a hidden bonus and reusable animated MDX components',async()=>{\\n const out=await compileDeck('examples/git-meta/deck.mdx','examples/git-meta/layout.json');\\n assert.equal(out.slides.length,8);\\n assert.equal(out.slides.filter(s=>!s.card.hidden).length,7);\\n assert.equal(out.slides[7].card.hidden,true);\\n assert.equal(out.durationSeconds,2100);\\n assert.equal(out.slides[0].models.length,3);\\n assert.equal(out.slides[0].models[0].animation.kind,'spin');\\n assert.match(out.slides[3].blocks.find(b=>b.kind==='pre').text,/git meta set commit:/);\\n assert.equal(out.slides[6].cameraDistance,2050);\\n assert.match(out.slides[6].notes,/README/);\\n});\\ntest('default route is deterministic and overrides do not reorder slides',()=>{\\n const tree=deck(slide('one'),slide('two'));\\n assert.deepEqual(makeManifest(tree),makeManifest(tree));\\n const out=makeManifest(tree,{slides:{two:{position:[100,200,300],yaw:90}}});\\n assert.deepEqual(out.slides.map(s=>s.id),['one','two']);\\n assert.deepEqual(out.slides[1].position,[100,200,300]);\\n assert.equal(out.slides[1].yaw,90);\\n});\\ntest('rejects duplicates, stale overrides, invalid geometry and invalid animations',()=>{\\n assert.throws(()=>makeManifest(deck(slide(),slide())),/duplicate/);\\n assert.throws(()=>makeManifest(deck(slide()),{slides:{typo:{}}}),/unknown slide/);\\n assert.throws(()=>makeManifest(deck(slide()),{slides:{one:{position:[0,NaN,0]}}}),/finite/);\\n assert.throws(()=>makeManifest(deck(slide()),{transition:0}),/positive/);\\n assert.throws(()=>makeManifest(deck(slide()),{durationMinutes:0}),/positive/);\\n assert.equal(makeManifest(deck(slide()),{durationMinutes:7.5}).durationSeconds,450);\\n assert.throws(()=>makeManifest(deck(slide('one',[h('animate',{kind:'unknown'},h('model'))]))),/animation/);\\n});\\ntest('rejects unsupported DOM rather than silently dropping authored content',()=>{\\n assert.throws(()=>makeManifest(deck(slide('one',[h('button',null,'click')]))),/Unsupported/);\\n});\\n\\n\\ntest('island habitat shuffle is deterministic, complete, and preserves the narrative',async()=>{\\n const {readFile}=await import('node:fs/promises');\\n const {islandLayout}=await import('../src/island.mjs');\\n const layout=JSON.parse(await readFile('examples/git-meta/layout.json','utf8'));\\n const a=islandLayout(layout,8), b=islandLayout(layout,8);\\n assert.deepEqual(a.route,b.route);\\n assert.equal(new Set(a.route.map(h=>h.id)).size,layout.habitats.length);\\n assert.notDeepEqual(a.route,layout.habitats);\\n assert.notDeepEqual(a.route,islandLayout({...layout,seed:42},8).route);\\n const out=await compileDeck('examples/git-meta/deck.mdx','examples/git-meta/layout.json');\\n assert.deepEqual(out.slides.map(s=>s.id),['opening','context','targets','authoring','storage','merging','scale','beach-bar']);\\n assert.deepEqual(out.slides.map(s=>s.habitat),a.route.slice(0,8).map(h=>h.id));\\n for(let i=0;i<8;i++) assert.deepEqual(out.slides[i].position,[...a.route[i].position.slice(0,2),a.route[i].position[2]+3200]);\\n assert.throws(()=>islandLayout({...layout,seed:-1},8),/seed/);\\n assert.throws(()=>islandLayout({...layout,habitats:[]},8),/one habitat/);\\n assert.throws(()=>islandLayout({...layout,habitats:Array(8).fill(layout.habitats[0])},8),/unique/);\\n});\\n\\ntest('every slide has one numbered destination, including all three facilities',async()=>{\\n const {readFile}=await import('node:fs/promises');\\n const layout=JSON.parse(await readFile('examples/git-meta/layout.json','utf8'));\\n const out=await compileDeck('examples/git-meta/deck.mdx','examples/git-meta/layout.json');\\n assert.deepEqual(out.slides.map(s=>s.card.code),['ENC-01','ENC-02','ENC-03','ENC-04','VC','HELI','GATE','BAR']);\\n assert.equal(new Set(out.slides.map(s=>s.card.slide)).size,8);\\n assert.equal(new Set(out.slides.map(s=>JSON.stringify(s.card.view.eye))).size,8);\\n assert.equal(out.slides[7].card.hidden,true);\\n assert.equal(out.slides[7].card.view.frameWidth,5500);\\n for(const s of out.slides)assert.equal(s.card.view.path.length,2);\\n for(const s of out.slides) {assert.equal(s.id,s.card.slide);assert.equal(s.transition,.8);}\\n const tree=deck(...out.slides.map(s=>slide(s.id)));\\n assert.throws(()=>makeManifest(tree,{...layout,cards:layout.cards.map((c,i)=>i?c:{...c,hidden:'yes'})}),/boolean/);\\n assert.throws(()=>makeManifest(tree,{...layout,cards:layout.cards.map((c,i)=>i?c:{...c,view:{...c.view,path:[]}})}),/two control/);\\n assert.throws(()=>makeManifest(tree,{...layout,cards:layout.cards.map((c,i)=>i?c:{...c,view:{...c.view,eye:[0,NaN,0]}})}),/finite/);\\n assert.throws(()=>makeManifest(tree,{...layout,cards:layout.cards.slice(1)}),/count/);\\n assert.throws(()=>makeManifest(tree,{...layout,cards:layout.cards.map((c,i)=>i?c:{...c,slide:'missing'})}),/unique known/);\\n assert.throws(()=>makeManifest(tree,{...layout,cards:layout.cards.map((c,i)=>i?c:{...c,position:[0,NaN,0]})}),/finite/);\\n});\\nimport {Deck, Slide, Model, Animate, Notes} from '../../src/components.jsx'\\nimport {MetadataOrbit, DataStore} from './components.jsx'\\n\\n<Deck title=\\\"Git metadata / Beyond the commit\\\">\\n\\n<Slide id=\\\"opening\\\" title=\\\"Beyond the commit\\\" accent=\\\"#563d72\\\">\\n\\n## GIT METADATA / 01\\n\\nCode has history. Now give it context.\\n\\nA proposal and Rust reference implementation for flexible, scalable metadata that travels with Git.\\n\\n<MetadataOrbit />\\n<Notes>Based on the sibling git-meta README. This is an overview of the proposal, not a replacement for its canonical spec.</Notes>\\n</Slide>\\n\\n<Slide id=\\\"context\\\" title=\\\"The context we lose\\\" accent=\\\"#7b303e\\\">\\n\\n## THE PROBLEM / 02\\n\\n- Trust: who made and reviewed this change?\\n- Provenance: which prompts and transcripts produced it?\\n- Review, testing, licensing and binary-file hints.\\n\\nCommit trailers and notes leave us with size limits, fixed fields and limited control over metadata properties.\\n\\n<MetadataOrbit />\\n</Slide>\\n\\n<Slide id=\\\"targets\\\" title=\\\"Attach it where it belongs\\\" accent=\\\"#294e7e\\\">\\n\\n## THE DATA MODEL / 03\\n\\nTarget + namespaced key + value.\\n\\n- Targets: commit, change ID, path, branch, project.\\n- Strings for individual values.\\n- Lists for appended entries; sets for unique members.\\n\\n<Model mesh=\\\"/Engine/BasicShapes/Sphere.Sphere\\\" position={[0,-1050,0]} scale={[3,3,3]} />\\n</Slide>\\n\\n<Slide id=\\\"authoring\\\" title=\\\"Small commands. Rich context.\\\" accent=\\\"#563d72\\\">\\n\\n## THE CLI / 04\\n\\n```sh\\ngit meta set commit:314e7f0fa7 agent:model \\\"claude-opus-4-6[1m]\\\"\\ngit meta list:push branch:sc-feature-1 review:comments \\\"love it\\\"\\ngit meta set:add path:src/metrics owners schacon\\n```\\n\\nKeys can be deeply namespaced. Read a namespace to retrieve its subkeys.\\n\\n<Notes>These commands come from the README examples. Refer to git-meta/spec for current CLI semantics.</Notes>\\n</Slide>\\n\\n<Slide id=\\\"storage\\\" title=\\\"Local speed. Git transport.\\\" accent=\\\"#7b303e\\\">\\n\\n## STORAGE & EXCHANGE / 05\\n\\nWork with tuples in a local SQLite database.\\n\\nSerialize shared values into a Git tree, then commit to refs/meta/local/main.\\n\\nFetch metadata into refs/meta/remotes/main and materialize it into the local store.\\n\\n<DataStore />\\n</Slide>\\n\\n<Slide id=\\\"merging\\\" title=\\\"Let the tree do the work\\\" accent=\\\"#294e7e\\\">\\n\\n## COLLABORATION / 06\\n\\nSeparate keys become separate tree entries.\\n\\n- Independent edits merge naturally.\\n- The README proposes local preference for conflicting values.\\n- Append-only list entries can combine across collaborators.\\n- Explicit tombstones express deletion; absence does not.\\n\\n<MetadataOrbit />\\n<Notes>The README labels spec/README.md canonical. This slide describes the README proposal rather than asserting current implementation conflict semantics.</Notes>\\n</Slide>\\n\\n<Slide id=\\\"scale\\\" title=\\\"Fetch what you need\\\" accent=\\\"#563d72\\\">\\n\\n## SCALE / 07\\n\\nLarge transcripts should not make every clone enormous.\\n\\nBlobless fetches bring down trees and commits. Pruned checkpoints keep a useful working set; older values can be fetched on demand.\\n\\nPublic, corporate and personal metadata can use separate destinations. Higher-level tools handle capture, display and synchronization.\\n\\nThe README reports about 500 MB of compressed transcript data versus less than 2 MB for its blobless example.\\n\\n<DataStore />\\n<Notes>The size comparison is a benchmark reported by the README author, not a benchmark of this slideshow engine.</Notes>\\n</Slide>\\n\\n<Slide id=\\\"beach-bar\\\" title=\\\"Nobody cares.\\\" accent=\\\"#537b3a\\\">\\n\\n## A LITTLE CONTEXT / 08\\n\\nWe have metadata here!\\n\\nKeep the useful context. Share it with the people who need it.\\n\\n<Notes>Hidden bonus stop. Press 8 to visit the beach bar behind the volcano. Replace this example with your own closing thought or questions.</Notes>\\n</Slide>\\n\\n</Deck>\\n# Metadata Properties\\n\\n- granularity (targets - file, line, byte?)\\n- mutability (mutable - locks, appendable - comments, immutable - authorship)\\n- exchange (local, exchanged, partially)\\n### 3. Problems with existing solutions\\n\\ncommit headers,\\nCODEOWNERS type files,\\ncommit message trailers,\\ngit notes\\n\\n- fixed targets\\n- fixed fields\\n- pollution\\n- size, scalability\\n# git-meta intro\\n\\na `git notes`-like key value system, but much more flexible.\\n\\n- fine-grained targets\\n- namespaced keys\\n- crdt-shaped data types\\n\\ngetting and setting example\\n## storage\\n\\n- sqlite, serialize, materialize\\n- sync\\n## exchange\\n\\n- tree storage\\n- ff-only\\n- filters / local\\n## scaling\\n\\n- partial/shallow/promisors\\n- pruning\\n- speed tests\\n## example: github blame\\n\\ngithub blame\\n\",\"wall_time_seconds\":2.333e-06}","type":"input_text"}],"session_id":"01a07b6d-991e-7c80-a5ae-46e3d782481b","source_line":6297,"timestamp":"2026-09-08T18:36:59.675Z","type":"custom_tool_call_output"}
