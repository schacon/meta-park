Point(const FWander& D,float Seconds) {\\n const float U=D.Phase+Seconds*D.Rate;\\n return FVector2D(D.Amplitude.X*(FMath::Sin(U)+.2f*FMath::Sin(U*1.71f+D.Phase)),\\n                  D.Amplitude.Y*(FMath::Cos(U)+.18f*FMath::Sin(U*1.31f-D.Phase)));\\n}\\nFTransform WanderPose(const FWander& D,float Seconds) {\\n const FVector2D Offset=WanderPoint(D,Seconds);\\n const FVector2D Tangent=WanderPoint(D,Seconds+.1f)-WanderPoint(D,Seconds-.1f);\\n const FRotator Facing(0,FMath::RadiansToDegrees(FMath::Atan2(Tangent.Y,Tangent.X)),0);\\n const FVector Center=D.Center+FVector(Offset.X,Offset.Y,0);\\n FVector Root=Center-Facing.RotateVector(D.LocalCenter*D.Scale);\\n Root.Z=(D.Raptor?D.Floor:IslandScene::GroundHeight(Center.X,Center.Y))-D.FootOffset;\\n return FTransform(Facing,Root,FVector(D.Scale));\\n}\\nvoid Wander(AStaticMeshActor* Actor,FVector Center,FVector2D Amplitude,int32 Seed,bool Raptor,bool Quad,FVector FenceCenter) {\\n FRandomStream Random(Seed);\\n const FBox Bounds=Actor->GetStaticMeshComponent()->GetStaticMesh()->GetBoundingBox();\\n auto* Material=UMaterialInstanceDynamic::Create(LoadObject<UMaterialInterface>(nullptr,TEXT(\\\"/Game/Models/Park/M_ParkDinosaur.M_ParkDinosaur\\\")),Actor);\\n check(Material);\\n for(int32 I=0;I<Actor->GetStaticMeshComponent()->GetNumMaterials();I++)Actor->GetStaticMeshComponent()->SetMaterial(I,Material);\\n const float Scale=Actor->GetActorScale3D().X;\\n Material->SetScalarParameterValue(TEXT(\\\"WalkScale\\\"),Scale);\\n Material->SetScalarParameterValue(TEXT(\\\"Quadruped\\\"),Quad?1:0);\\n const FVector LocalCenter(Bounds.GetCenter().X,Bounds.GetCenter().Y,0);\\n Wanderers.Add({Actor,Material,Center,LocalCenter,FenceCenter,Amplitude,Random.FRandRange(0,2*PI),\\n  (Random.RandRange(0,1)?1.f:-1.f)*2*PI/Random.FRandRange(180,260),Scale,float(Bounds.Min.Z*Scale),float(Center.Z),Raptor});\\n}\\nTArray<FVector> GroundVertices;\\nTArray<FIntVector> GroundTriangles;\\nAStaticMeshActor* Asset(UWorld* World,const FString& Name,FVector Position=FVector::ZeroVector,float Yaw=0,float Scale=1) {\\n const FString Path=FString::Printf(TEXT(\\\"/Game/Models/Park/%s.%s\\\"),*Name,*Name);\\n auto* Mesh=LoadObject<UStaticMesh>(nullptr,*Path);\\n if(!Mesh) { UE_LOG(LogTemp,Fatal,TEXT(\\\"Missing Blender asset %s. Run npm run unreal:import-assets.\\\"),*Path); return nullptr; }\\n auto* Actor=World->SpawnActor<AStaticMeshActor>(Position,FRotator(0,Yaw,0));\\n auto* Component=Actor->GetStaticMeshComponent();\\n Component->SetMobility(EComponentMobility::Movable);\\n Component->SetStaticMesh(Mesh); if(Name==TEXT(\\\"SM_Water\\\"))Component->SetCastShadow(false); Component->SetCollisionEnabled(ECollisionEnabled::NoCollision);\\n Actor->SetActorScale3D(FVector(Scale)); return Actor;\\n}\\nFVector Position(const TArray<TSharedPtr<FJsonValue>>& Values) {\\n return FVector(Values[0]->AsNumber(),Values[1]->AsNumber(),Values[2]->AsNumber());\\n}\\n}\\nvoid IslandScene::Animate(float Seconds) {\\n for(const auto& D:Wanderers)if(D.Actor.IsValid()) {\\n  auto Pose=WanderPose(D,Seconds);\\n  const float Step=Seconds*FMath::Abs(D.Rate)*FMath::Max(D.Amplitude.X,D.Amplitude.Y)/(D.Scale*24)*2*PI+D.Phase;\\n  Pose.AddToTranslation(FVector(0,0,2*FMath::Abs(FMath::Sin(Step))));\\n  D.Actor->SetActorTransform(Pose);\\n  if(D.Material.IsValid()) {\\n   D.Material->SetScalarParameterValue(TEXT(\\\"WalkPhase\\\"),Step);\\n   D.Material->SetVectorParameterValue(TEXT(\\\"WalkOrigin\\\"),FLinearColor(Pose.GetLocation()));\\n   D.Material->SetVectorParameterValue(TEXT(\\\"WalkForward\\\"),FLinearColor(Pose.GetRotation().GetForwardVector()));\\n   D.Material->SetVectorParameterValue(TEXT(\\\"WalkRight\\\"),FLinearColor(Pose.GetRotation().GetRightVector()));\\n  }\\n }\\n for(const auto& S:Splashes)if(S.Actor.IsValid()) {\\n  const float Pulse=FMath::Sin(Seconds*4.f+S.Phase);\\n  S.Actor->SetActorScale3D(FVector(1+.22f*Pulse,1+.22f*Pulse,1+.32f*Pulse)*S.Scale);\\n  S.Actor->SetActorLocation(S.Origin+FVector(0,0,12*FMath::Max(0.f,Pulse)));\\n }\\n}\\nbool IslandScene::ValidateWandering() {\\n const FVector2D Fence[]={FVector2D(-2,-15),{-9,-14.5},{-14,-10.8},{-15,-3},{-13,7},{-8,13.5},{0,15},{10,13},{14.5,7},{14,-3},{10,-12},{2,-15}};\\n bool Good=Wanderers.Num()==6;\\n for(float Time=0;Time<=2100;Time+=2) {\\n  TArray<FVector> Raptors;\\n  for(const auto& D:Wanderers) {\\n   const FTransform Pose=WanderPose(D,Time);\\n   const FBox Bounds=D.Actor->GetStaticMeshComponent()->GetStaticMesh()->GetBoundingBox();\\n   for(float X:{float(Bounds.Min.X),float(Bounds.Max.X)})for(float Y:{float(Bounds.Min.Y),float(Bounds.Max.Y)}) {\\n    const FVector P=Pose.TransformPosition(FVector(X,Y,0))-D.FenceCenter;\\n    if(D.Raptor)Good&=FMath::Abs(P.X)<1777&&FMath::Abs(P.Y)<1225;\\n    else for(int32 I=0;I<12;I++) {\\n     const FVector2D A=Fence[I]*140,B=Fence[(I+1)%12]*140,E=B-A,V=FVector2D(P.X,P.Y)-A;\\n     Good&=-(E.X*V.Y-E.Y*V.X)/E.Size()>20;\\n    }\\n   }\\n   if(D.Raptor)Raptors.Add(Pose.TransformPosition(D.LocalCenter));\\n   // Reject jumps or fast translation even during the tightest turn.\\n   Good&=FVector::Dist2D(Pose.GetLocation(),WanderPose(D,Time+.1f).GetLocation())<10;\\n  }\\n  for(int32 I=0;I<Raptors.Num();I++)for(int32 J=I+1;J<Raptors.Num();J++)Good&=FVector::Dist2D(Raptors[I],Raptors[J])>1080;\\n }\\n UE_LOG(LogTemp,Display,TEXT(\\\"SlideSmoke: six slow wandering dinosaurs stay inside fences and raptors remain separated over 35 minutes=%s\\\"),Good?TEXT(\\\"PASS\\\"):TEXT(\\\"FAIL\\\"));\\n return Good;\\n}\\nfloat IslandScene::GroundHeight(float X,float Y) {\\n for(const auto& T:GroundTriangles) {\\n  const FVector A=GroundVertices[T.X],B=GroundVertices[T.Y],C=GroundVertices[T.Z];\\n  const double D=(B.Y-C.Y)*(A.X-C.X)+(C.X-B.X)*(A.Y-C.Y);if(FMath::Abs(D)<.001)continue;\\n  const double U=((B.Y-C.Y)*(X-C.X)+(C.X-B.X)*(Y-C.Y))/D;\\n  const double V=((C.Y-A.Y)*(X-C.X)+(A.X-C.X)*(Y-C.Y))/D;\\n  if(U>=-.0001&&V>=-.0001&&U+V<=1.0001)return U*A.Z+V*B.Z+(1-U-V)*C.Z;\\n }\\n return 200.f;\\n}\\nIslandScene::FStats IslandScene::Build(UWorld* World,const TArray<TSharedPtr<FJsonValue>>& Habitats,int32 Seed) {\\n FString Source;\\n if(!FFileHelper::LoadFileToString(Source,*(FPaths::ProjectContentDir()/TEXT(\\\"Slides/park-assets.json\\\")))) {\\n  UE_LOG(LogTemp,Fatal,TEXT(\\\"Missing park asset placement manifest. Run npm run unreal:import-assets.\\\")); return {};\\n }\\n TSharedPtr<FJsonObject> Manifest;\\n if(!FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(Source),Manifest) || !Manifest.IsValid()) {\\n  UE_LOG(LogTemp,Fatal,TEXT(\\\"Invalid Blender park placement manifest\\\")); return {};\\n }\\n GroundVertices.Reset();GroundTriangles.Reset();Splashes.Reset();Wanderers.Reset();\\n FString GroundJson;TSharedPtr<FJsonObject> Ground;\\n if(FFileHelper::LoadFileToString(GroundJson,*(FPaths::ProjectContentDir()/TEXT(\\\"Slides/park-ground.json\\\")))&&FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(GroundJson),Ground)) {\\n  for(const auto& V:Ground->GetArrayField(TEXT(\\\"vertices\\\")))GroundVertices.Add(Position(V->AsArray())*100);\\n  for(const auto& T:Ground->GetArrayField(TEXT(\\\"triangles\\\"))){const auto& A=T->AsArray();GroundTriangles.Add(FIntVector(A[0]->AsNumber(),A[1]->AsNumber(),A[2]->AsNumber()));}\\n }\\n // Scenery uses Blender placements; habitat inhabitants still follow the editable deck layout.\\n TSet<FString> Species;\\n for(const auto& Habitat:Habitats) Species.Add(TEXT(\\\"SM_\\\")+Habitat->AsObject()->GetStringField(TEXT(\\\"species\\\")));\\n int32 Count=0,Trees=0,Dinosaurs=0;\\n    assets[name]=col;parts.clear();return col\\n\\ndef instance(name,p=(0,0,0),yaw=0,scale=1):\\n    o=bpy.data.objects.new(name+' • placed',None);o.instance_type='COLLECTION';o.instance_collection=assets[name]\\n    scene.collection.objects.link(o);o.location=p;o.rotation_euler.z=math.radians(yaw);o.scale=(scale,)*3\\n    placements.append(dict(asset=name,position=list(p),yaw=yaw,scale=scale));return o\\n\\n# Dinosaur sculpture library: deliberate silhouettes, tapered limbs, separate jaws and details.\\ndef dinosaur(species,c):\\n    begin(); quad=species in ('brachiosaurus','triceratops','stegosaurus')\\n    if species=='brachiosaurus':\\n        tube('barrel torso',[(-2,0,2.8),(-1.3,0,3.2),(.1,0,3.4),(1.4,0,3.5),(2,0,3.8)],[(.5,.65),(1.4,1.15),(1.65,1.3),(1.45,1.1),(.85,.75)],c,10)\\n        tube('sweeping neck',[(1.3,0,3.8),(2,0,4.6),(2.35,0,6),(2.75,0,7.4),(3.1,0,8.4),(3.7,0,8.8)],[.95,.8,.63,.5,.43,.38],c,9)\\n        tube('gentle muzzle',[(3.35,0,8.7),(3.9,0,8.7),(4.4,0,8.55)],[.48,(.44,.52),(.27,.35)],c,8)\\n        head=(3.9,0,8.85); eye_x=3.82; eye_z=8.94; eye_y=.48\\n        tube('long counterbalance tail',[(-1.7,0,3),(-3.1,0,2.8),(-4.5,.2,2.6),(-6,.5,2.5),(-7,.7,2.7)],[.72,.52,.33,.17,.025],c)\\n        for x in (-1.15,1.3):\\n            for side in (-1,1):\\n                y=side*.87; xx=x+(.15 if side==1 else 0)\\n                tube('pillar leg',[(xx,y,3),(xx+.12,y*1.15,1.8),(xx+.03,y*1.2,.5),(xx+.15,y*1.2,.18)],[.55,.42,.35,.4],c)\\n                for toe in (-1,0,1):ell('ivory nail',(xx+.49,y*1.2+toe*.18,.16),(.15,.11,.13),IVORY,6,3)\\n    elif species in ('triceratops','stegosaurus'):\\n        stego=species=='stegosaurus'\\n        tube('armoured torso',[(-2,0,2),(-1.25,0,2.4),(0,0,2.6),(1.4,0,2.4),(2,0,2)],[(.65,.6),(1.25,1.1),(1.45,1.3),(1.05,.95),(.65,.6)],c,10)\\n        for x in (-1.1,1.2):\\n            for s in (-1,1):\\n                tube('bent weight-bearing leg',[(x,s*.8,2.5),(x-.25,s*1.05,1.2),(x+.12,s*1.08,.25)],[.55,.4,.3],c)\\n                ell('broad foot',(x+.25,s*1.08,.22),(.53,.36,.25),tone(c,.86),8,3)\\n                for toe in (-1,0,1):ell('hoof',(x+.64,s*1.08+toe*.18,.14),(.17,.1,.13),IVORY,6,3)\\n        tube('tapering tail',[(-1.8,0,2.2),(-3,0,1.9),(-4.3,.2,1.6),(-5.3,.5,1.75)],[.65,.42,.22,.025],c)\\n        if stego:\\n            tube('low browsing head',[(1.7,0,2),(2.5,0,1.5),(3.2,0,1.4)],[(.55,.5),(.45,.4),(.23,.3)],c)\\n            eye_x=2.65;eye_z=1.75;eye_y=.35\\n            for j in range(9):\\n                x=-2.4+j*.51; h=1.1+1.25*math.sin(math.pi*(j+1)/10)\\n                for s in (-1,1):\\n                    xx=x+(s+1)*.1; yy=s*.38; z=3.35-.18*abs(x)\\n                    mesh('stegosaur plate',[(xx-.36,yy,z),(xx-.45,yy,z+h*.62),(xx-.06,yy,z+h),(xx+.42,yy,z+h*.55),(xx+.33,yy,z),(xx,yy+s*.19,z+h*.46)],[(0,1,5),(1,2,5),(2,3,5),(3,4,5),(4,0,5),(4,3,2,1,0)],'#deb978')\\n            for x in (-4.2,-4.8):\\n                for s in (-1,1): tube('tail spike',[(x,s*.1,1.7),(x-.3,s*.75,2),(x-.55,s*1.1,2.2)],[.16,.1,0],IVORY,7)\\n        else:\\n            tube('cheek and muzzle',[(1.5,0,2.5),(2.35,0,2.35),(3.25,0,1.8),(3.65,0,1.7)],[(1,.85),(.75,.78),(.42,.45),(.18,.28)],c,9)\\n            # Fan-shaped bony frill with a bevelled, scalloped perimeter.\\n            rim=[]\\n            for j in range(14):\\n                a=2*math.pi*j/14;rim.append((1.6-.32*math.sin(a),1.38*math.cos(a),2.6+1.42*math.sin(a)))\\n            vs=[(1.95,0,2.65)]+rim+[(x-.16,y*.86,2.6+(z-2.6)*.86) for x,y,z in rim]\\n            fs=[]; cs=[]\\n            for j in range(14):fs.extend([(0,j+1,(j+1)%14+1),(j+1,15+j,15+(j+1)%14,(j+1)%14+1)]);cs.extend([tone(c,.9),IVORY])\\n            mesh('scalloped shield',vs,fs,c,cs)\\n            for s in (-1,1):tube('brow horn',[(2.25,s*.52,2.95),(2.75,s*.6,3.7),(3.35,s*.62,4.1)],[.23,.14,.015],IVORY,8)\\n            tube('nasal horn',[(3.15,0,2.12),(3.55,0,2.7)],[.18,.015],IVORY,8)\\n            eye_x=2.45;eye_z=2.6;eye_y=.72\\n            tube('dark beak',[(3.35,0,1.82),(3.68,0,1.65),(3.5,0,1.42)],[.28,.21,.03],tone(c,.54),7)\\n    else:\\n        rex=species=='tyrannosaurus'; galli=species=='gallimimus'; para=species=='parasaurolophus'; dilo=species=='dilophosaurus'\\n        size=1 if rex else .8\\n        tube('balanced torso',[(-1.7,0,2.6),(-.8,0,3.1),(.35,0,3.5),(1.25,0,3.85)],[(.55,.6),(1.05,.86),(1,.8),(.62,.5)],c,10)\\n        tube('athletic neck',[(.9,0,3.7),(1.55,0,4.35),(1.85,0,5)],[(.65,.55),(.5,.42),(.42,.37)],c)\\n        if rex:\\n            tube('sculpted skull',[(1.55,0,5),(2.05,0,5.25),(2.95,0,5.22),(3.65,0,5.05)],[(.48,.5),(.65,.68),(.6,.62),(.44,.5)],c,8)\\n            tube('mouth interior',[(2.05,0,4.9),(3.5,0,4.82)],[(.11,.53),(.09,.46)],'#6e392c',8)\\n            tube('lower jaw',[(1.85,0,4.8),(2.6,0,4.56),(3.5,0,4.65)],[(.25,.45),(.2,.49),(.16,.4)],tone(c,1.12),8)\\n            for s in (-1,1):\\n                for j in range(5):tube('tooth',[(2.4+j*.22,s*.48,4.93),(2.44+j*.22,s*.48,4.71)],[.065,.003],IVORY,5)\\n            eye_x=2.04;eye_z=5.5;eye_y=.61\\n        else:\\n            tube('streamlined head',[(1.7,0,5),(2.15,0,5.2),(2.75,0,5.13),(3.25,0,4.96)],[(.38,.38),(.43,.42),(.3,.32),(.14,.2)],c,8)\\n            tube('beak edge',[(2.65,0,4.98),(3.26,0,4.9)],[(.05,.28),(.025,.16)],tone(c,.5),6)\\n            eye_x=2.1;eye_z=5.36;eye_y=.4\\n            if para:tube('swept crest',[(1.9,0,5.5),(1.15,0,5.8),(.45,0,5.75),(.12,0,5.4)],[.24,.2,.16,.06],'#d5b06e',8)\\n            if dilo:\\n                for s in (-1,1):\\n                    tube('cranial crest',[(1.75,s*.2,5.45),(2.25,s*.2,5.9),(2.72,s*.16,5.38)],[.15,.19,.05],'#d29447',7)\\n                    vs=[(1.15,0,4.8)]+[(1.05, s*(.3+1.25*math.sin(math.pi*j/7)),4+1.2*math.cos(math.pi*j/7)) for j in range(8)]\\n                    mesh('display frill',vs,[(0,j+1,j+2) for j in range(7)],'#dcb55b',[tone('#dcb55b',.85+.1*(j%3)) for j in range(7)])\\n        tube('sinuous tail',[(-1.3,0,2.8),(-2.6,0,2.6),(-3.9,.2,2.45),(-5.2,.6,2.7),(-6,1,3)],[.66,.46,.26,.12,.015],c)\\n        for s in (-1,1):\\n            step=.35 if s==1 else -.25\\n            tube('muscular thigh',[(-.55,s*.55,3),(-.95+step,s*.92,1.8)],[.75,.49],c,9)\\n            tube('angled shin',[(-.95+step,s*.92,1.8),(-.6+step,s*.92,.7),(-.15+step,s*.94,.25)],[.37,.2,.2],c,8)\\n            for toe in (-1,0,1):\\n                y=s*.94+toe*.18\\n                tube('splayed toe',[(-.2+step,y,.25),(.25+step,y+toe*.06,.15),(.75+step,y+toe*.1,.12)],[.15,.12,.045],tone(c,.84),6)\\n                tube('claw',[(.65+step,y+toe*.1,.15),(.92+step,y+toe*.1,.08)],[.09,0],IVORY,6)\\n            reach=.45 if rex else 1\\n            tube('forearm',[(.7,s*.55,3.6),(1.05,s*.85,3.1),(1.05+reach,s*.9,3.2)],[.21,.14,.09],c,7)\\n            for j in range(2 if rex else 3):tube('finger',[(1.05+reach,s*.9+j*.1,3.2),(1.3+reach,s*.9+j*.1,3.05)],[.065,0],IVORY,6)\\n        # Angular dorsal markings are mesh details, not floating decals.\\n        for j in range(5):ell('dorsal scale',(-1.4+j*.42,0,3.4+.14*j),(.2,.35,.18),tone(c,.67),6,3)\\n    for s in (-1,1):\\n        ell('eye socket',(eye_x,s*eye_y,eye_z),(.22,.095,.23),tone(c,.57),8,4)\\n        ell('amber eye',(eye_x+.055,s*(eye_y+.065),eye_z+.015),(.13,.055,.14),'#f5d477',8,4)\\n        ell('pupil',(eye_x+.095,s*(eye_y+.104),eye_z+.015),(.045,.018,.095),DARK,6,4)\\n        ell('eye glint',(eye_x+.115,s*(eye_y+.12),eye_z+.07),(.026,.014,.03),WHITE,6,3)\\n        beam('eyebrow',(eye_x-.16,s*eye_y,eye_z+.2),(eye_x+.19,s*eye_y,eye_z+.19),.095,c)\\n    finish('SM_'+species)\\n\\nfor species,c in [('brachiosaurus','#379489'),('tyrannosaurus','#e86731'),('triceratops','#cab26b'),('velociraptor','#66876c'),('dilophosaurus','#8c9d48'),('gallimimus','#d59a4f'),('stegosaurus','#779569'),('parasaurolophus','#538d83')]:dinosaur(species,c)\\n\\n# Two simple plaster volumes with substantial stepped roofs and a recessed entry.\\nbegin()\\nPLASTER='#deded4'\\n# Positive X appears at the left of the isometric park view.\\nfor x,y,w,d,h in [(6,-1,9,8,5.8),(-4,1,9,10,10)]:\\n    box('plain plaster block',(x,y,h/2),(w,d,h),PLASTER)\\nscripts/import_park_assets.py:111:    for slot in range(len(mesh.static_materials)):mesh.set_material(slot,beacon if name=='SM_RaptorBeacon' else water if name in ('SM_Water','SM_WaterSplash') else material)\\nscripts/prepare_dino_material.py:3:path='/Game/Models/Park/M_ParkDinosaur'\\nscripts/prepare_dino_material.py:5:if not mat:mat=unreal.AssetToolsHelpers.get_asset_tools().create_asset('M_ParkDinosaur','/Game/Models/Park',unreal.Material,unreal.MaterialFactoryNew())\\nscripts/prepare_dino_material.py:36:unreal.log('ParkDinosaur: walking material saved')\\nbuild.mjs\\nbuild_park_assets.py\\nimport_park_assets.py\\nmodel_raptor_pen.py\\nprepare.py\\nprepare_dino_material.py\\nunreal.mjs\\n\",\"wall_time_seconds\":6.25e-06}","type":"input_text"},{"text":"[{\"description\":\"text tools (grep, file read, etc.):\\n  * `data/api/` - Blender Python API reference (RST files per module/class).\\n    Consult when writing or debugging `bpy` code: operator signatures, type\\n    properties, enum values, etc.\\n  * `data/manual/` - Blender user manual (RST files mirroring the official manual structure).\\n    Consult for conceptual explanations, workflow guidance, and feature overviews.\\n\\n# Executing Code\\n\\nThe `execute_blender_code` tool runs Python code via `bpy` in the connected Blender instance.\\n\\nThe `execute_blender_code` tool is a last resort, if there are other tools that provide\\nthe functionality you need, use those instead.\\n\\nPrefer operators (`bpy.ops`) for standard actions (adding primitives, applying modifiers,\\nsetting origins) - they handle defaults and context. Use the data API (`bpy.data`) for\\nprecise control or to avoid side effects.\\n\\nMany operators depend on the current mode (Object, Edit, Sculpt, etc.) and which objects\\nare active/selected. Verify or set the mode first - wrong mode either fails or silently\\ndoes nothing.\\n\\nThe **active object** and **selection** are distinct. Many operators require both.\\nSet them explicitly - do not assume the current state. Operators change selection and\\nactive state as a side effect, so re-set both between sequential operator calls on\\ndifferent objects.\\n\\nUpdate the dependency graph after changes before reading computed properties\\n(world matrices, modifier results, etc.).\\n\\nIn edit mode, access mesh geometry through the bmesh API, not the regular mesh data API.\\nFlush bmesh changes back to the mesh - forgetting this silently loses all edits.\\n\\nReturn structured data (dicts, lists) from executed code, not print output.\\n\\n# Scene & Data Structure\\n\\nBlender uses a datablock system - objects and their underlying data (meshes, materials,\\ncameras, etc.) are separate entities.\\n\\nHierarchy:\\n  * **Scene** - top-level container. A .blend can have multiple.\\n  * **View Layer** - controls collection visibility/selectability.\\n  * **Collection** - organizational tree. Objects live in collections; can be nested;\\n    objects can belong to multiple collections.\\n  * **Object** - has a transform (location, rotation, scale) and references underlying data\\n    (Mesh, Curve, Camera, etc.). Multiple objects can share the same data (linked duplicates).\\n  * **Datablocks** - the actual data: geometry, materials, textures, etc.\\n\\nKey concepts:\\n  * Objects and data are separate - deleting one does not delete the other.\\n  * Orphaned datablocks (zero users) are purged on save/reload or manual purge.\\n  * Objects created via the data API must be linked to a collection to appear in a scene.\\n  * Shared data: check user count before modifying a datablock - editing a shared mesh\\n    affects all objects referencing it. Make single-user first if needed.\\n  * In most cases file assets:\\n    * Images, Fonts, Sounds, other `.blend` files -  corraspond to a data-block.\\n\\nVisibility has three independent states:\\n  * **Viewport hidden** - still fully scriptable.\\n  * **Disabled in view layer** - excluded; may be inaccessible to view-layer-dependent operators.\\n  * **Disabled for render** - skipped during render, otherwise normal.\\nCheck these when objects seem \\\"missing\\\" or operators skip them.\\n\\nBlender defaults to meters. Check scene unit settings before creating dimensioned objects.\\n\\nExploring scenes:\\n  * Walk the collection hierarchy for an overview first.\\n  * Don't dump entire scenes - inspect progressively for large scenes.\\n  * Check object types, parenting, modifiers, and materials before making changes.\\n\\n# Object Types & Creation\\n\\nObject types: Mesh, Curve, Surface, Metaball, Text (Font), Armature, Lattice,\\nEmpty, Camera, Light, Light Probe, Grease Pencil.\\n\\nCreating objects:\\n  * Operators for standard primitives - handle defaults and collection linking.\\n  * Data API for procedural/batch creation - avoids side effects (selection changes, etc.).\\n  * Always link new objects to a collection.\\n  * Names auto-append `.001`, `.002` on collision - capture references immediately\\n    after creation, never look up by assumed name.\\n\\nDelete with unlinking enabled to cleanly remove from all collections.\\n\\nPrefer non-destructive workflows: modifiers over direct mesh edits where possible,\\nkeeping changes adjustable. Apply or edit directly only when final or unavoidable.\\n\\n# Transformations & Coordinate Spaces\\n\\nLocation, rotation, and scale are in local space (parent-relative, or world if unparented).\\n\\nRotation mode determines which property to use (Euler, Quaternion, Axis-Angle).\\nAlways check rotation mode first - writing to the wrong property is silently ignored.\\n\\nCoordinate spaces:\\n  * **World** - global. Use the world matrix for reliable positions.\\n  * **Local** - relative to parent. Location/rotation/scale operate here.\\n  * **Object** - the object's own system. Mesh vertices are in object space;\\n    multiply by world matrix for world positions.\\n\\nStrategies:\\n  * The origin is the reference point for location; vertices are relative to it.\\n  * Apply transforms (especially scale) before geometry-dependent operations\\n    (booleans, physics) - non-uniform scale causes unexpected results.\\n  * Set the parent inverse matrix when parenting to preserve visual position.\\n  * Use the world matrix for world-space reads, not manual composition of\\n    location/rotation/scale.\\n  * The 3D cursor is a persistent world-space reference used by many operations.\\n\\n\\n        Execute Python code in the connected Blender instance.\\n\\n        The code runs in Blender's Python environment with full access to ``bpy``.\\n        To return data, assign a JSON-serialisable dict to a variable named ``result``.\\n        Deferred completion via ``check_is_finished`` is only supported by the\\n        interactive addon server, and is rejected in background mode.\\n        \\n\\nexec tool declaration:\\n```ts\\ndeclare const tools: { mcp__blender__execute_blender_code(args: { code: string; }): Promise<CallToolResult<{ [key: string]: unknown; }>>; };\\n```\",\"name\":\"mcp__blender__execute_blender_code\"}]","type":"input_text"}],"session_id":"01a07b6d-991e-7c80-a5ae-46e3d782481b","source_line":3925,"timestamp":"2026-09-08T06:10:18.580Z","type":"custom_tool_call_output"}
