e)\\n+\\n+\\n+class Plan:\\n+    def __init__(self, directory):\\n+        self.directory = directory\\n+        self.entries = []\\n+\\n+    def value(self, target, key, value, kind='string'):\\n+        if kind == 'string' and not isinstance(value, str):\\n+            value = dumps(value)\\n+        self.entries.append({'target': target, 'key': key, 'type': kind, 'value': value})\\n+\\n+    def chunks(self, key, data, encoding):\\n+        parts = []\\n+        # Split UTF-8 strings at character boundaries; bytes are base64 before this call.\\n+        size = CHUNK // 4\\n+        for i, offset in enumerate(range(0, len(data), size)):\\n+            part = data[offset:offset + size]\\n+            part_key = f'{key}:part:{i:06d}'\\n+            self.value('project', part_key, part)\\n+            parts.append({'key': part_key, 'sha256': digest(part.encode()), 'bytes': len(part.encode())})\\n+        index = {'encoding': encoding, 'sha256': digest(data.encode()), 'parts': parts}\\n+        self.value('project', key + ':index', index)\\n+        return index\\n+\\n+    def save(self):\\n+        write_json(self.directory / 'plan.json', self.entries)\\n+\\n+\\n+def get_value(repo, target, key):\\n+    p = run(['git-meta', 'get', target, key, '--json'], repo)\\n+    if not p.stdout.strip():\\n+        return None\\n+    value = json.loads(p.stdout)\\n+    if target.startswith('path:'):\\n+        return value.get(target[5:], {}).get(key)\\n+    for part in key.split(':'):\\n+        if not isinstance(value, dict) or part not in value:\\n+            return None\\n+        value = value[part]\\n+    return value\\n+\\n+\\n+def apply(args):\\n+    plan = json.loads((args.directory / 'plan.json').read_text())\\n+    changed = 0\\n+    for i, entry in enumerate(plan):\\n+        target, key, value = entry['target'], entry['key'], entry['value']\\n+        current = get_value(args.repo, target, key)\\n+        if entry['type'] == 'set':\\n+            for member in sorted